# Copie para .env (backend lê do cwd) — tudo opcional; sem keys, providers pagos ficam 'unavailable' honestos
IDS_DATA_DIR=./data
IDS_DB_URL=sqlite:///./data/studio.db

# Providers (plugins) — active per capability (empty = first registered)
IDS_EMBEDDINGS_PROVIDER=openclip
IDS_PREANNOTATION_PROVIDER=openai_vision
IDS_CAPTIONING_PROVIDER=openai_vision
IDS_PII_PROVIDER=openai_vision
IDS_LABEL_ISSUES_PROVIDER=cleanlab

# OpenAI Vision (pre-annotation, captions, and PII) — paid, key required
IDS_OPENAI_API_KEY=
IDS_OPENAI_BASE_URL=https://api.openai.com/v1
IDS_OPENAI_VISION_MODEL=gpt-4o-mini

# Replicate hosted vision models — paid, configure a model slug
IDS_REPLICATE_API_TOKEN=
IDS_REPLICATE_MODEL=

# fal.ai hosted vision models — paid, configure a model slug
IDS_FAL_API_KEY=
IDS_FAL_MODEL=

# Local OpenCLIP
IDS_OPENCLIP_PRETRAINED=openai
